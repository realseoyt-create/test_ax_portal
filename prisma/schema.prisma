generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model System {
  id               String   @id @default(cuid())
  name             String
  shortDescription String
  description      String
  link             String?
  creatorName      String

  // Reserved for future SSO-based ownership. Null until SSO is introduced.
  ownerId          String?

  tags             Tag[]         @relation("SystemTags")
  images           SystemImage[]
  hearts           Heart[]

  createdAt        DateTime @default(now())
}

model Tag {
  id      String   @id @default(cuid())
  name    String   @unique
  systems System[] @relation("SystemTags")
}

model SystemImage {
  id        String  @id @default(cuid())
  systemId  String
  system    System  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  path      String
  isPrimary Boolean @default(false)
  order     Int     @default(0)
}

model Heart {
  id          String   @id @default(cuid())
  systemId    String
  system      System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  anonymousId String
  createdAt   DateTime @default(now())

  @@unique([systemId, anonymousId])
}

// AX 스타터 키트: 핵심 툴 설치 가이드 / 데이터레이크 접근 링크 모음.
// 카탈로그(System)와 구조는 비슷하지만 등록은 관리자 코드로 제한되고, link는 필수다.
model KitItem {
  id               String   @id @default(cuid())
  name             String
  shortDescription String
  description      String
  link             String
  creatorName      String

  // Reserved for future SSO-based ownership. Null until SSO is introduced.
  ownerId          String?

  tags             KitTag[]       @relation("KitItemTags")
  images           KitItemImage[]
  hearts           KitHeart[]

  createdAt        DateTime @default(now())
}

model KitTag {
  id    String    @id @default(cuid())
  name  String    @unique
  items KitItem[] @relation("KitItemTags")
}

model KitItemImage {
  id        String  @id @default(cuid())
  itemId    String
  item      KitItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  path      String
  isPrimary Boolean @default(false)
  order     Int     @default(0)
}

model KitHeart {
  id          String   @id @default(cuid())
  itemId      String
  item        KitItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  anonymousId String
  createdAt   DateTime @default(now())

  @@unique([itemId, anonymousId])
}
